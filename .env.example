# 🔒 NUNCA subas este archivo con valores reales
# Copia como .env.local para desarrollo

# Database (Neon)
DATABASE_URL=postgres://user:pass@host.neon.tech/dbname?sslmode=require

# Redis (Upstash o local)
REDIS_URL=redis://localhost:6379

# Blockchain RPC
RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR-KEY

# App
WEB_URL=http://localhost:3001
NODE_ENV=development
LOG_LEVEL=debug

# Ports
PORT=3000
HOST=0.0.0.0

# Auth
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3001

# GCP (solo producción, gestionado por OIDC)
# GCP_PROJECT_ID=
# GCP_SERVICE_ACCOUNT=
# GCP_WORKLOAD_IDENTITY_PROVIDER=
